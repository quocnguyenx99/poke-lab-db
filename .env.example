# Sao chép thành .env.local rồi điền giá trị. KHÔNG commit file .env*.

# Nguồn dữ liệu catalog: json (mặc định) | sheets (Lab 1) | firestore (Lab 2)
DATA_SOURCE=json

# Lab 1 — URL Web App của Apps Script (kết thúc bằng /exec)
SHEETS_API_URL=

# Lab 2 — Firebase web config (Project settings → Your apps → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Lab 2 — đường dẫn file service account (chỉ dùng cho script seed, chạy trên máy)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
